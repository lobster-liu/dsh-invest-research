{
  "name": "dsh-invest-research",
  "version": "0.5.6",
  "description": "Multi-agent equity & fund research skill bundle for DeepSeek Harness — stock-research (6-role A-share pipeline), fund-research (7-role fund look-through pipeline with 10-section reports), and the pick-funds analyst suite (screening, fund/manager profiles, holdings-style, fund watch, PDF/DOCX/XLSX delivery), with source-cited data, multi-channel fetchers, and a shared pre-write PII gate.",
  "license": "MIT",
  "author": "lobster-liu",
  "homepage": "https://github.com/lobster-liu/dsh-invest-research#readme",
  "bugs": {
    "url": "https://github.com/lobster-liu/dsh-invest-research/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!**/__pycache__/**",
    "!**/*.pyc"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "test:python": "python assets/skills/stock-research/tools/test_gate.py && python assets/skills/fund-research/tools/test_fund_tools.py && python assets/skills/fund-research/tools/test_peer_tools.py",
    "test:all": "npm run test && npm run test:python"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "stock",
    "fund",
    "etf",
    "lof",
    "a-share",
    "multi-agent",
    "research",
    "pick-funds",
    "screening",
    "portfolio",
    "fund-profile",
    "fund-watch",
    "holdings-style",
    "manager-profile",
    "report-render",
    "xlsx-author"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lobster-liu/dsh-invest-research.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
